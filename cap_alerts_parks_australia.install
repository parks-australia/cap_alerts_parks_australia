<?php

/**
 * Implements hook_install().
 */
function cap_alerts_parks_australia_install()
{
    _cap_alerts_parks_australia_provision_fields();
}

/**
 * Creates/updates the Parks-specific fields on the CAP Alert content type.
 *
 * Shared between hook_install() (fresh installs) and the update hook below
 * (sites where the module is already installed), so both stay in sync.
 *
 * * These values are repeated in cap_alerts_parks_australia_uninstall()
 *   below and must be kept in sync.
 */
function _cap_alerts_parks_australia_provision_fields()
{
    $content_type = 'cap_alert_message';
    $close_park_field_name = 'field_close_park';
    $close_locations_field_name = 'field_location_reference_close';
    $location_reference_field_name = 'field_location_reference';
    $park_reference_field_name = 'field_site';

    // Check if the content type exists.
    if (!\Drupal::entityTypeManager()->getStorage('node_type')->load($content_type)) {
        \Drupal::logger('cap_alerts_parks_australia')->warning('The content type ' . $content_type . ' does not exist. The fields ' . $location_reference_field_name . ', ' . $close_park_field_name . ', and ' . $close_locations_field_name . ' were not created in ' . $content_type . '.');
        return;
    }

    // Create field storage, unless the field already exists.
    //
    // NOTE: We don't check for 'field_site' here because we assume it's already
    // installed on the Parks Australia Drupal website
    if (!\Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.' . $location_reference_field_name)) {
        $field_storage = [
            'field_name' => $location_reference_field_name,
            'entity_type' => 'node',
            'type' => 'entity_reference',
            'settings' => [
                'target_type' => 'node',
            ],
            'cardinality' => -1,
            'translatable' => TRUE,
        ];
        \Drupal\field\Entity\FieldStorageConfig::create($field_storage)->save();
    }
    // Close-park / close-locations fields remain disabled; they belong to a
    // separate, not-yet-integrated "park closure" workflow.
    // if (!\Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.' . $close_park_field_name)) {
    //     $field_storage = [
    //         'field_name' => $close_park_field_name,
    //         'entity_type' => 'node',
    //         'type' => 'boolean',
    //         'settings' => [
    //             'default_value' => 0,
    //             0 => 'No',
    //             1 => 'Yes, CLOSE THE PARK',
    //         ],
    //         'cardinality' => 1,
    //         'translatable' => TRUE,
    //     ];
    //     \Drupal\field\Entity\FieldStorageConfig::create($field_storage)->save();
    // }
    // if (!\Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.' . $close_locations_field_name)) {
    //     $field_storage = [
    //         'field_name' => $close_locations_field_name,
    //         'entity_type' => 'node',
    //         'type' => 'boolean',
    //         'settings' => [
    //             'default_value' => 0,
    //             0 => 'No',
    //             1 => 'Yes',
    //         ],
    //         'cardinality' => 1,
    //         'translatable' => TRUE,
    //     ];
    //     \Drupal\field\Entity\FieldStorageConfig::create($field_storage)->save();
    // }

    // Create field instance for the CAP Alert bundle. The Park field is
    // restricted to website (non-"_app") Gatsby endpoints, since Alerts only
    // ever apply to the map/website context; a shortcode-normalisation rule
    // elsewhere strips "_app" when matching, so a single website selection
    // also covers any future mobile-app consumption.
    $park_field_config = \Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $park_reference_field_name);
    if (!$park_field_config) {
        $field = [
            'field_name' => $park_reference_field_name,
            'entity_type' => 'node',
            'bundle' => $content_type,
            'label' => 'Park',
            'description' => 'Which park does this Alert relate to? Ctrl+Click to select multiple options',
            'required' => TRUE,
            'settings' => [
                'handler' => 'cap_alerts_parks_australia_gatsby_endpoint_website',
                'handler_settings' => [],
            ],
        ];
        \Drupal\field\Entity\FieldConfig::create($field)->save();
    }
    elseif ($park_field_config->getSetting('handler') !== 'cap_alerts_parks_australia_gatsby_endpoint_website') {
        $park_field_config->setSetting('handler', 'cap_alerts_parks_australia_gatsby_endpoint_website');
        $park_field_config->setSetting('handler_settings', []);
        $park_field_config->save();
    }

    if (!\Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $location_reference_field_name)) {
        $field = [
            'field_name' => $location_reference_field_name,
            'entity_type' => 'node',
            'bundle' => $content_type,
            'label' => 'Related Locations',
            'description' => '<p>Locations inside this Alert\'s polygon/circle area(s) are related automatically. Any related Locations will show this Alert anywhere they appear.</p>
            <p>Add Locations here manually only if a Location is genuinely impacted and:</p>
            <ul>
            <li>this Alert doesn\'t have any mapping coordinates, or</li>
            <li>this Alert DOES have mapping coordinates, but the Location falls outside the affected area.</li>
            </ul>',
            'required' => FALSE,
            'settings' => [
                'handler' => 'default',
                'handler_settings' => [
                    'target_bundles' => ['location' => 'location'],
                ],
            ],
        ];
        \Drupal\field\Entity\FieldConfig::create($field)->save();
    }
    // if (!\Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $close_park_field_name)) {
    //     $field = [
    //         'field_name' => $close_park_field_name,
    //         'entity_type' => 'node',
    //         'bundle' => $content_type,
    //         'label' => 'Close the ENTIRE PARK?',
    //         'description' => '<p>If YES, ALL park Locations will appear as \'Closed\' and a closure banner will appear on all pages until this Alert expires.</p>',
    //         'required' => TRUE,
    //         'default_value' => 0,
    //         'settings' => [],
    //     ];
    //     \Drupal\field\Entity\FieldConfig::create($field)->save();
    // }
    // if (!\Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $close_locations_field_name)) {
    //     $field = [
    //         'field_name' => $close_locations_field_name,
    //         'entity_type' => 'node',
    //         'bundle' => $content_type,
    //         'label' => 'Close related Locations?',
    //         'description' => '<p>If YES, any Locations referenced by this Alert will appear as \'Closed\' until this Alert expires.</p>',
    //         'required' => TRUE,
    //         'default_value' => 0,
    //         'settings' => [
    //             'handler' => 'default',
    //             'handler_settings' => [
    //                 'target_bundles' => ['location' => 'location'],
    //             ],
    //         ],
    //     ];
    //     \Drupal\field\Entity\FieldConfig::create($field)->save();
    // }

    // Set field widget settings
    $form_display = \Drupal::entityTypeManager()
        ->getStorage('entity_form_display')
        ->load('node.' . $content_type . '.default');
    if ($form_display && method_exists($form_display, 'setComponent')) {
        $form_display->setComponent($park_reference_field_name, [
            'type' => 'gatsby_endpoints_select',
            'weight' => 10,
            'settings' => [],
        ]);
        $form_display->setComponent($location_reference_field_name, [
            'type' => 'entity_reference_autocomplete',
            'weight' => 20,
            'settings' => [
                'match_operator' => 'CONTAINS',
                'size' => 60,
                'autocomplete_type' => 'tags',
                'placeholder' => '',
            ],
        ]);
        // $form_display->setComponent($close_locations_field_name, [
        //     'type' => 'options_buttons',
        //     'weight' => 12,
        //     'settings' => [],
        // ]);
        // $form_display->setComponent($close_park_field_name, [
        //     'type' => 'options_buttons',
        //     'weight' => 13,
        //     'settings' => [],
        // ]);
        $form_display->save();
    }

    // Field display settings
    $view_display = \Drupal::entityTypeManager()
        ->getStorage('entity_view_display')
        ->load('node.' . $content_type . '.default');
    if ($view_display && method_exists($view_display, 'setComponent')) {
        $view_display->setComponent($park_reference_field_name, [
            'label' => 'above',
            'type' => 'boolean',
            'weight' => 11,
            'settings' => [
                'format' => 'entity_reference_label',
            ],
        ]);
        $view_display->setComponent($location_reference_field_name, [
            'label' => 'above',
            'type' => 'entity_reference_label',
            'weight' => 20,
        ]);
        // $view_display->setComponent($close_locations_field_name, [
        //     'label' => 'above',
        //     'type' => 'boolean',
        //     'weight' => 15,
        //     'settings' => [
        //         'format' => 'yes-no',
        //     ],
        // ]);
        // $view_display->setComponent($close_park_field_name, [
        //     'label' => 'above',
        //     'type' => 'boolean',
        //     'weight' => 16,
        //     'settings' => [
        //         'format' => 'yes-no',
        //     ],
        // ]);
        $view_display->save();
    }
}

/**
 * Re-enables field_location_reference and restricts the Park field.
 *
 * Applies the same field provisioning as hook_install() to sites where this
 * module is already installed (hook_install() only runs on fresh installs).
 */
function cap_alerts_parks_australia_update_10001()
{
    _cap_alerts_parks_australia_provision_fields();
}

/**
 * Implements hook_uninstall().
 */
function cap_alerts_parks_australia_uninstall()
{
    // * These values are repeated in cap_alerts_parks_australia_install()
    //   above and must be kept in sync
    $park_reference_field_name = 'field_site';
    $location_reference_field_name = 'field_location_reference';
    $close_park_field_name = 'field_close_park';
    $close_locations_field_name = 'field_location_reference_close';
    $content_type = 'cap_alert_message';

    // Here we leave any fields that already existed in the site before this
    // module was installed. This prevents breaking other content that may use
    // these fields.

    // Remove the field instances
    if ($field = \Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $park_reference_field_name)) {
        $field->delete();
    }
    if ($field = \Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $location_reference_field_name)) {
        $field->delete();
    }
    if ($field = \Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $close_park_field_name)) {
        $field->delete();
    }
    if ($field = \Drupal::entityTypeManager()->getStorage('field_config')->load('node.' . $content_type . '.' . $close_locations_field_name)) {
        $field->delete();
    }

    // Remove the fields' storage if no other bundles use it.
    if ($storage = \Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.' . $park_reference_field_name)) {
        $storage->delete();
    }
    if ($storage = \Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.' . $location_reference_field_name)) {
        $storage->delete();
    }
    if ($storage = \Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.' . $close_park_field_name)) {
        $storage->delete();
    }
    if ($storage = \Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.' . $close_locations_field_name)) {
        $storage->delete();
    }
}
